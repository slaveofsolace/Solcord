<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SoulCordInstaller</AssemblyName>
    <RootNamespace>SoulCord.Installer</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(SoulCordEmbeddedArtifact)" LogicalName="SoulCord.Installer.Resources.soulcord.asar" Condition="'$(SoulCordEmbeddedArtifact)' != ''" />
    <EmbeddedResource Include="$(SoulCordEmbeddedBuildManifest)" LogicalName="SoulCord.Installer.Resources.soulcord-build-manifest.json" Condition="'$(SoulCordEmbeddedBuildManifest)' != ''" />
    <EmbeddedResource Include="$(SoulCordEmbeddedInstallerManifest)" LogicalName="SoulCord.Installer.Resources.soulcord-installer-manifest.json" Condition="'$(SoulCordEmbeddedInstallerManifest)' != ''" />
  </ItemGroup>

  <Target Name="RequireEmbeddedInstallerBundle" BeforeTargets="PrepareForBuild" Condition="'$(SoulCordRequireEmbeddedBundle)' == 'true'">
    <Error Condition="'$(SoulCordEmbeddedArtifact)' == '' Or !Exists('$(SoulCordEmbeddedArtifact)')" Text="The manifest-bound SoulCord ASAR resource is missing." />
    <Error Condition="'$(SoulCordEmbeddedBuildManifest)' == '' Or !Exists('$(SoulCordEmbeddedBuildManifest)')" Text="The authoritative SoulCord build manifest resource is missing." />
    <Error Condition="'$(SoulCordEmbeddedInstallerManifest)' == '' Or !Exists('$(SoulCordEmbeddedInstallerManifest)')" Text="The SoulCord installer manifest resource is missing." />
  </Target>
</Project>
